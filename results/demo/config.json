{
  "name": "faircare_fl_demo",
  "seed": 42,
  "logdir": "results/demo",
  "model": {
    "model_type": "mlp",
    "input_dim": 10,
    "hidden_dims": [
      64,
      32
    ],
    "output_dim": 1,
    "dropout": 0.1,
    "activation": "relu"
  },
  "data": {
    "dataset": "synth_health",
    "sensitive_attribute": "sex",
    "n_clients": 10,
    "partition": "dirichlet",
    "alpha": 0.5,
    "train_ratio": 0.8,
    "val_ratio": 0.15,
    "test_ratio": 0.2,
    "batch_size": 32,
    "seed": 42
  },
  "training": {
    "algo": "faircare_fl",
    "rounds": 25,
    "local_epochs": 1,
    "lr": 0.01,
    "weight_decay": 0.0001,
    "momentum": 0.0,
    "server_lr": 1.0,
    "eval_every": 1,
    "checkpoint_every": 10,
    "early_stopping_rounds": null,
    "device": "cpu"
  },
  "fairness": {
    "alpha": 1.0,
    "beta": 1.0,
    "gamma": 0.8,
    "delta": 0.2,
    "delta_init": 0.2,
    "delta_min": 0.01,
    "tau": 1.0,
    "tau_init": 1.0,
    "tau_min": 0.3,
    "tau_anneal": true,
    "tau_anneal_rate": 0.95,
    "mu": 0.9,
    "mu_client": 0.0,
    "theta_server": 0.9,
    "lambda_fair": 0.1,
    "lambda_fair_init": 0.1,
    "lambda_fair_min": 0.01,
    "lambda_fair_max": 2.0,
    "lambda_adapt_rate": 1.2,
    "bias_threshold_eo": 0.15,
    "bias_threshold_fpr": 0.15,
    "bias_threshold_sp": 0.1,
    "thr_eo": 0.15,
    "thr_fpr": 0.15,
    "thr_sp": 0.1,
    "w_eo": 1.0,
    "w_fpr": 0.5,
    "w_sp": 0.5,
    "epsilon": 0.005,
    "weight_clip": 3.0,
    "enable_bias_detection": true,
    "enable_server_momentum": true,
    "enable_multi_metric": true,
    "variance_penalty": 0.1,
    "improvement_bonus": 0.1,
    "participation_boost": 0.15,
    "fairness_loss_type": "eo_sp_combined"
  },
  "secure_agg": {
    "enabled": false,
    "protocol": "additive_masking",
    "precision": 16,
    "modulus": 4294967296
  },
  "algo": {
    "fedprox_mu": 0.01,
    "q": 2.0,
    "q_eps": 0.0001,
    "afl_lambda": 0.1,
    "afl_smoothing": 0.01,
    "faircare_momentum": 0.9,
    "faircare_anneal_rounds": 5,
    "convergence_threshold": 0.01,
    "bias_mitigation_extra_epochs": 1,
    "bias_mitigation_lr_multiplier": 1.2
  }
}